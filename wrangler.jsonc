{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ihnotic-site",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "ihnotic.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
